<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LinkX Grabber</title>
    <link rel="manifest" href="manifest.json">
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #0f172a; color: white; padding: 20px; text-align: center; margin: 0; }
        .card { background: #1e293b; padding: 25px; border-radius: 16px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); max-width: 400px; margin: 40px auto; border: 1px solid #334155; }
        h1 { color: #38bdf8; margin-bottom: 5px; font-size: 28px; }
        p { color: #94a3b8; font-size: 14px; margin-bottom: 20px; }
        input { width: 90%; padding: 14px; margin: 15px 0; border: 2px solid #334155; background: #0f172a; color: white; border-radius: 8px; font-size: 16px; outline: none; }
        input:focus { border-color: #38bdf8; }
        button { width: 95%; padding: 14px; background-color: #0284c7; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: bold; transition: 0.2s; }
        button:hover { background-color: #0369a1; }
        .format-list { margin-top: 25px; display: flex; flex-direction: column; gap: 12px; }
        .download-btn { background-color: #22c55e; animation: fadeIn 0.3s ease-in; }
        .download-btn:hover { background-color: #16a34a; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

<div class="card">
    <h1>LinkX Grabber</h1>
    <p id="status">स्क्रीन पर कहीं भी टच करें, लिंक अपने आप आ जाएगा...</p>
    
    <input type="text" id="urlInput" placeholder="यहाँ यूआरएल (URL) अपने आप आएगा">
    <button id="fetchBtn">वीडियो / ऑडियो फॉर्मेट चेक करें</button>
    
    <div class="format-list" id="formatList"></div>
</div>

<script src="app.js"></script>
</body>
</html>
